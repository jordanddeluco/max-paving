# Copy to manage/server/.env and fill in. Never commit the real .env.

# Port and the address people use to reach the panel (https:// in production).
PORT=8790
PUBLIC_URL=http://localhost:8790

# Where the company's data is kept. Back this folder up.
# DATA_DIR=/var/lib/maxpaving-manage

# Long random string. Encrypts the stored QuickBooks tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# QuickBooks Online app keys from https://developer.intuit.com (My Apps → Keys & credentials).
# Use the Development keys with QBO_ENV=sandbox first, then Production keys with QBO_ENV=production.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
# Must match a Redirect URI saved in the Intuit app exactly.
# QBO_REDIRECT_URI=http://localhost:8790/api/qbo/callback
